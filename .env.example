# Puertos del entorno de desarrollo.
#
# Copiar a .env solo si alguno choca con otro proyecto que tengas corriendo.
# `make dev` lo crea solo si no existe. .env está en .gitignore: es tuyo.
#
# Ver qué está ocupando un puerto:
#   docker ps --format '{{.Names}}\t{{.Ports}}' | grep 3000

WEB_PORT=3000
API_PORT=8080
DB_PORT=5432
